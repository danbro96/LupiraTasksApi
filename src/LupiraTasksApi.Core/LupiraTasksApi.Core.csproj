<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bounded context: Domain (event-sourced aggregates), Application (services),
         Data (Marten config + idempotency). No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Lupira.Identity.Marten" Version="0.1.0" />
    <PackageReference Include="Lupira.Marten.Idempotency" Version="0.1.0" />
    <PackageReference Include="Lupira.Postgres.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Results" Version="1.0.0" />
    <PackageReference Include="Marten" Version="9.40.0" />
    <!-- VTODO (de)serialization for the CalDAV surface (DAVx5). Same lib/version LupiraCalApi uses. -->
    <PackageReference Include="Ical.Net" Version="5.2.2" />
  </ItemGroup>

</Project>
